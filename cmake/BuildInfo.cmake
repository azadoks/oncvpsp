# Write the build information include file (see src/build_info_m.F90).
#
# Run in script mode at every build:
#   cmake -DSOURCE_DIR=<source tree> -DOUTPUT=<build_info.inc> -P BuildInfo.cmake
#
# The git commit of SOURCE_DIR, whether the source differs from it, and the build time are written to
# OUTPUT. The source differs from the commit if a tracked file is modified or a file under src/ is
# untracked (and not ignored); a hash of those differences distinguishes builds of different
# uncommitted sources. OUTPUT is rewritten, with a new build time, only when the commit or the
# differences change, so that an up-to-date build does not recompile or relink anything.
# string(TIMESTAMP) honours SOURCE_DATE_EPOCH.

if (NOT SOURCE_DIR OR NOT OUTPUT)
    message(FATAL_ERROR "BuildInfo.cmake: SOURCE_DIR and OUTPUT must be defined")
endif ()

set(commit "unknown")
set(state "unknown")
set(diff_hash "")

find_program(GIT_EXECUTABLE git)
if (GIT_EXECUTABLE)
    execute_process(
        COMMAND "${GIT_EXECUTABLE}" rev-parse HEAD
        WORKING_DIRECTORY "${SOURCE_DIR}"
        RESULT_VARIABLE git_result
        OUTPUT_VARIABLE git_commit
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET
    )
    if (git_result EQUAL 0)
        set(commit "${git_commit}")
        execute_process(
            COMMAND "${GIT_EXECUTABLE}" diff --no-ext-diff HEAD
            WORKING_DIRECTORY "${SOURCE_DIR}"
            OUTPUT_VARIABLE git_diff
            ERROR_QUIET
        )
        execute_process(
            COMMAND "${GIT_EXECUTABLE}" ls-files --others --exclude-standard -- src
            WORKING_DIRECTORY "${SOURCE_DIR}"
            OUTPUT_VARIABLE git_untracked
            OUTPUT_STRIP_TRAILING_WHITESPACE
            ERROR_QUIET
        )
        set(differences "${git_diff}")
        if (git_untracked)
            string(REPLACE "\n" ";" untracked_files "${git_untracked}")
            foreach (file IN LISTS untracked_files)
                file(SHA1 "${SOURCE_DIR}/${file}" file_hash)
                string(APPEND differences "untracked ${file} ${file_hash}\n")
            endforeach ()
        endif ()
        if (differences STREQUAL "")
            set(state "clean")
        else ()
            string(SHA1 diff_hash "${differences}")
            string(SUBSTRING "${diff_hash}" 0 12 diff_hash)
            set(state "modified")
        endif ()
    endif ()
endif ()

set(key "${commit} ${state} ${diff_hash}")
if (EXISTS "${OUTPUT}")
    file(STRINGS "${OUTPUT}" old_key LIMIT_COUNT 1 REGEX "^! key: ")
    if (old_key STREQUAL "! key: ${key}")
        return()
    endif ()
endif ()

if (state STREQUAL "modified")
    set(state_text "modified (diff ${diff_hash})")
else ()
    set(state_text "${state}")
endif ()
string(TIMESTAMP build_time "%Y-%m-%dT%H:%M:%SZ" UTC)

file(WRITE "${OUTPUT}"
"! key: ${key}
! Generated by cmake/BuildInfo.cmake; do not edit.
 character(len=*), parameter :: build_commit = '${commit}'
 character(len=*), parameter :: build_source = '${state_text}'
 character(len=*), parameter :: build_time = '${build_time}'
")
