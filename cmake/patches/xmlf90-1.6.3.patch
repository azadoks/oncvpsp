+!-----------------------------------------------------------------
+subroutine destroy_elstack(elstack)
+  type(elstack_t), intent(inout)  :: elstack
+
+  if (associated(elstack%stack)) deallocate(elstack%stack)
+  nullify(elstack%stack)
+  elstack%n_items = 0
+
+end subroutine destroy_elstack
