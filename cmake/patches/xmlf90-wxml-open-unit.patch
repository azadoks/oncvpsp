+!-------------------------------------------------------------------
+! Write the document to lun, a formatted unit the caller has opened and
+! positioned at the start of a record (such as the standard output), with
+! the record length it was opened with; xml_Close leaves it open
+subroutine xml_OpenUnit(lun, xf, indent)
+integer, intent(in)           :: lun
+type(xmlf_t), intent(inout)   :: xf
+logical, intent(in), optional :: indent
+
+character(len=24) :: name
+
+write(name,"(a,i0)") "unit ", lun
+allocate(xf%filename(len_trim(name)))
+call assign_str_to_array(xf%filename,trim(name))
+
+xf%lun = lun
+xf%close_unit = .false.
+
+call init_elstack(xf%stack)
+
+call init_dict(xf%dict)
+call reset_buffer(xf%buffer)
+
+xf%start_tag_closed = .true.
+xf%root_element_output = .false.
+xf%inhibit_lf = .false.
+
+xf%indenting_requested = .false.
+if (present(indent)) then
+   xf%indenting_requested = indent
+endif
+end subroutine xml_OpenUnit
+
