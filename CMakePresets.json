{
    "version": 3,
    "cmakeMinimumRequired": {"major": 3, "minor": 22, "patch": 0},
    "configurePresets": [
        {
            "name": "default",
            "displayName": "RelWithDebInfo (-O2 -g), the build the test references are checked against",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {"CMAKE_BUILD_TYPE": "RelWithDebInfo"}
        },
        {
            "name": "debug",
            "displayName": "Debug, with run-time checks and floating-point traps",
            "binaryDir": "${sourceDir}/build-debug",
            "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug"}
        },
        {
            "name": "release",
            "displayName": "Release, with fast math",
            "binaryDir": "${sourceDir}/build-release",
            "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"}
        },
        {
            "name": "study",
            "inherits": "release",
            "displayName": "Release (-O3 -march=native -ffast-math -funroll-loops) in its own directory, for the oncvpsp-opt study",
            "binaryDir": "${sourceDir}/build-study",
            "cacheVariables": {
                "CMAKE_Fortran_FLAGS_RELEASE": "-O3 -march=native -DNDEBUG"
            }
        },
        {
            "name": "trap",
            "displayName": "-O3 -march=native with floating-point traps (invalid, zero, overflow) and no fast math, for the oncvpsp-opt study: a NaN or Inf stops the run where it is made",
            "binaryDir": "${sourceDir}/build-trap",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Trap",
                "CMAKE_Fortran_FLAGS_TRAP": "-O3 -march=native -funroll-loops -g -fbacktrace -ffpe-trap=invalid,zero,overflow -DNDEBUG",
                "CMAKE_C_FLAGS_TRAP": "-O3 -march=native -DNDEBUG"
            }
        },
        {
            "name": "fetch",
            "inherits": "default",
            "displayName": "RelWithDebInfo, building LAPACK, Libxc and toml-f instead of using the system's",
            "binaryDir": "${sourceDir}/build-fetch",
            "cacheVariables": {
                "ONCVPSP_LAPACK_SOURCE": "FETCH",
                "ONCVPSP_Libxc_SOURCE": "FETCH",
                "ONCVPSP_TOML_SOURCE": "FETCH"
            }
        },
        {
            "name": "profile",
            "inherits": "default",
            "displayName": "RelWithDebInfo with frame pointers, for perf record -g",
            "binaryDir": "${sourceDir}/build-profile",
            "cacheVariables": {
                "CMAKE_Fortran_FLAGS_RELWITHDEBINFO": "-O2 -g -DNDEBUG -fno-omit-frame-pointer -mno-omit-leaf-frame-pointer"
            }
        },
        {
            "name": "coverage",
            "displayName": "-O0 with gcov counters, for scripts/coverage.py",
            "binaryDir": "${sourceDir}/build-cov",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Coverage",
                "CMAKE_Fortran_FLAGS_COVERAGE": "-O0 -g --coverage",
                "CMAKE_EXE_LINKER_FLAGS_COVERAGE": "--coverage"
            }
        }
    ],
    "buildPresets": [
        {"name": "default", "configurePreset": "default"},
        {"name": "debug", "configurePreset": "debug"},
        {"name": "release", "configurePreset": "release"},
        {"name": "study", "configurePreset": "study"},
        {"name": "trap", "configurePreset": "trap"},
        {"name": "fetch", "configurePreset": "fetch"},
        {"name": "profile", "configurePreset": "profile"},
        {"name": "coverage", "configurePreset": "coverage"}
    ],
    "testPresets": [
        {
            "name": "default",
            "configurePreset": "default",
            "output": {"outputOnFailure": true},
            "execution": {"jobs": 8},
            "filter": {"exclude": {"label": "smooth"}}
        },
        {"name": "debug", "inherits": "default", "configurePreset": "debug"},
        {"name": "release", "inherits": "default", "configurePreset": "release"},
        {"name": "study", "inherits": "default", "configurePreset": "study"},
        {"name": "trap", "inherits": "default", "configurePreset": "trap"},
        {"name": "fetch", "inherits": "default", "configurePreset": "fetch"}
    ]
}
